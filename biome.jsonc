{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  // Code and JSON only: Markdown is prose, and the output style's emphasis is part of the voice.
  "files": {
    "includes": ["**/*.{js,mjs,ts,tsx,json,jsonc}", "!**/package-lock.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 200
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      // The mods moved from Token-Effort unchanged; these rules flag code that is correct as written.
      "includes": ["overhaul-mods/**"],
      "linter": {
        "rules": {
          "suspicious": {
            // The output parsers strip ANSI escapes and control characters on purpose.
            "noControlCharactersInRegex": "off",
            // The sprite bakers use forEach with expression-bodied arrows for their side effects.
            "useIterableCallbackReturn": "off"
          },
          "correctness": {
            // Engine hooks take ($, e, next) whether or not they read each one.
            "noUnusedFunctionParameters": "off",
            // Doomwheel's ticker is only ever written through ??=, which guards a single clock.every.
            "noUnusedVariables": "off"
          },
          "complexity": {
            "useOptionalChain": "off"
          }
        }
      }
    }
  ]
}
